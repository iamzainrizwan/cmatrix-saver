#!/usr/bin/env bash
# cmatrix "screensaver" for GNOME/Wayland (which has no screensaver hooks).
#
# Polls Mutter's IdleMonitor; after IDLE_SECS of no input it opens a
# fullscreen kitty on every monitor running cmatrix-saver-scene (fade-in +
# decrypt title, then a scene: cmatrix in your terminal's own colours —
# CMATRIX_SAVER_GREY=1 turns its green rain grey — pipes.sh or snake, with
# a tmux status bar on the primary monitor: host, now playing, idle,
# battery, clock). Input resets the idle timer and this loop kills the
# windows (unless it was a saver key, see below).
# (Not cmatrix -s: kitty's startup terminal replies count as a "keystroke"
# and it quits instantly.) Skips triggering while something holds an
# idle inhibitor (video playback, presentations) or the screen is locked.
#
# One window per monitor: Mutter has no layer-shell and ignores client
# positions for native Wayland windows, so each kitty runs under XWayland
# with --position inside its monitor and fullscreens there. Trade-off:
# XWayland renders at 1x, so text is slightly soft on fractionally scaled
# displays. CMATRIX_SAVER_SINGLE=1 restores the old single native window.
#
# Notices: on the primary monitor a pane along the top lists what the
# sources in sources/ (or ~/.config/cmatrix-saver/sources/) reported since
# the saver came up; out of the box that's Claude Code sessions that finished
# or need input (sources/claude, wired up as a Claude Code hook). Sources
# with a `watch` collector run in the background alongside this loop.
#
# Saver keys (space, 1-9, c, s, n, p, t, m, b, r, ?) are handled in the
# scene, which stamps $RUN/key so the input they cause doesn't close the
# windows here; esc/q stamp $RUN/quit, which does. Any other key or the mouse closes it.
# Each launch picks one scene at random for every monitor: cmatrix, pipes.sh
# when it's installed, or one from scenes/ (CMATRIX_SAVER_SCENES narrows
# the pool); s cycles through them.
#
# Run via cmatrix-saver.service (systemd user unit, see README).
# `cmatrix-saver now [away message]` shows it straight away (bind it to a
# shortcut; the message replaces the hostname in the status bar) and
# `cmatrix-saver blank` goes straight to plain black (no title, scene or
# bar) and `cmatrix-saver test` counts down from 5 first; all show it once,
# regardless of idle time, and exit when it closes.
# GNOME's own blank/lock (Settings > Power > Screen Blank) must be set
# longer than IDLE_SECS, or the screen blanks before cmatrix shows.

IDLE_SECS=${CMATRIX_SAVER_IDLE:-300}
POLL=2
# systemd's PATH has neither ~/.local/bin nor /usr/games (Debian's pipes)
PATH=$HOME/.local/bin:$PATH:/usr/games
RUN=${XDG_RUNTIME_DIR:-/tmp}/cmatrix-saver-$UID
mkdir -p "$RUN"
export CMATRIX_SAVER_RUN=$RUN
# Prefer kitty's official installer location (~/.local/bin): systemd's PATH
# doesn't include it, and distro packages (e.g. Ubuntu's 0.32) are too old
# for --position, so every launch would fail instantly.
KITTY=$HOME/.local/bin/kitty
[[ -x $KITTY ]] || KITTY=$(command -v kitty)
KITTEN="$(dirname "$(readlink -f "$KITTY")")/kitten"
SCENE="$(dirname "$(readlink -f "$0")")/cmatrix-saver-scene"
export KITTEN
pids=()
launched=0

idle_ms() {
  gdbus call --session --dest org.gnome.Mutter.IdleMonitor \
    --object-path /org/gnome/Mutter/IdleMonitor/Core \
    --method org.gnome.Mutter.IdleMonitor.GetIdletime 2>/dev/null |
    grep -oE '[0-9]+' | tail -1
}

# 8 = GSM_INHIBITOR_FLAG_IDLE
idle_inhibited() {
  gdbus call --session --dest org.gnome.SessionManager \
    --object-path /org/gnome/SessionManager \
    --method org.gnome.SessionManager.IsInhibited 8 2>/dev/null | grep -q true
}

locked() {
  gdbus call --session --dest org.gnome.ScreenSaver \
    --object-path /org/gnome/ScreenSaver \
    --method org.gnome.ScreenSaver.GetActive 2>/dev/null | grep -q true
}

# "x y primary" (top-left in logical px, 1 if GNOME's primary display) of
# each monitor, from Mutter's DisplayConfig.
monitors() {
  python3 - 2>/dev/null <<'EOF'
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio
bus = Gio.bus_get_sync(Gio.BusType.SESSION)
state = bus.call_sync(
    "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
    "org.gnome.Mutter.DisplayConfig", "GetCurrentState",
    None, None, 0, -1, None).unpack()
for x, y, _scale, _transform, primary, *_ in state[2]:
    print(x, y, int(primary))
EOF
}

pick_scene() {
  local pool
  mapfile -t pool < <("$SCENE" scenes)
  ((${#pool[@]})) || pool=(cmatrix)
  echo "${pool[RANDOM % ${#pool[@]}]}"
}

launch() {
  rm -f "$RUN/key" "$RUN/quit"
  launched=$(date +%s%3N)
  # notices only count from now: Mutter's idle time also covers you reading
  # the screen, so anything before the saver covered it you may have seen
  date +%s%3N >"$RUN/since"
  CMATRIX_SAVER_SCENE=$(pick_scene)
  export CMATRIX_SAVER_SCENE
  local common=(--class cmatrix-saver --start-as fullscreen
    -o background=#000000 -o window_padding_width=0
    -o background_opacity=0 -o dynamic_background_opacity=yes
    -o allow_remote_control=socket-only)
  # cmatrix draws its rain in ANSI green and its heads in white: optionally
  # map them to dark/mid grey and off-white, whatever kitty.conf says
  [[ ${CMATRIX_SAVER_GREY:-0} == 1 ]] && common+=(
    -o color2=#333333 -o color10=#666666
    -o color7=#e0e0e0 -o foreground=#e0e0e0)
  local mons x y primary n=0
  [[ ${CMATRIX_SAVER_SINGLE:-0} == 1 ]] || mapfile -t mons < <(monitors)

  if ((${#mons[@]} == 0)); then
    CMATRIX_SAVER_PRIMARY=1 "$KITTY" "${common[@]}" \
      --listen-on "unix:@cmatrix-saver-$$" "$SCENE" &
    pids+=($!)
    return
  fi
  # the scene gives the primary monitor the host title + status bar; the
  # others decrypt the time/date instead and run the same scene, no bar
  local placements=()
  for m in "${mons[@]}"; do
    read -r x y primary <<<"$m"
    CMATRIX_SAVER_SLOT=$n CMATRIX_SAVER_PRIMARY=$primary \
      "$KITTY" -o linux_display_server=x11 \
      --position "$((x + 50))x$((y + 50))" "${common[@]}" \
      --listen-on "unix:@cmatrix-saver-$$-$n" "$SCENE" &
    pids+=($!)
    placements+=("$! $x $y")
    ((n++)) # not inside the & command: that runs in a subshell
  done
  place "${placements[@]}" &
}

# Mutter can ignore --position too (seen on GNOME 46 with a fractionally
# scaled monitor: every window landed on the same monitor, the primary's on
# top), so once each kitty's window is up, ask for it to be fullscreened on
# its monitor explicitly (_NET_WM_FULLSCREEN_MONITORS). It also gives each
# window a blank pointer: kitty only hides it after the mouse has been still
# over a focused window, which a shortcut-launched one may never be (any
# mouse movement closes the saver anyway). Args: "pid x y"...
place() {
  python3 - "$@" 2>/dev/null <<'EOF'
import os, re, subprocess, sys, time
import gi
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gdk, GdkX11

Gdk.set_allowed_backends("x11")
disp = Gdk.Display.open(os.environ["DISPLAY"])
mons = {}
for i in range(disp.get_n_monitors()):
    g = disp.get_monitor(i).get_geometry()
    mons[g.x, g.y] = i
want = {}
for arg in sys.argv[1:]:
    pid, x, y = map(int, arg.split())
    if (x, y) in mons:
        want[pid] = mons[x, y]

blank = Gdk.Cursor.new_for_display(disp, Gdk.CursorType.BLANK_CURSOR)

def out(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout

deadline = time.monotonic() + 10
while want and time.monotonic() < deadline:
    time.sleep(0.25)
    tree = out("xwininfo", "-root", "-tree")
    for xid in re.findall(r'^\s*(0x[0-9a-f]+) .*\("cmatrix-saver"', tree, re.M):
        props = out("xprop", "-id", xid, "_NET_WM_PID", "_NET_WM_STATE")
        m = re.search(r"_NET_WM_PID\(CARDINAL\) = (\d+)", props)
        # mapped and managed: Mutter has applied --start-as fullscreen
        if not m or "_NET_WM_STATE_FULLSCREEN" not in props:
            continue
        mon = want.pop(int(m.group(1)), None)
        if mon is not None:
            win = GdkX11.X11Window.foreign_new_for_display(disp, int(xid, 16))
            win.fullscreen_on_monitor(mon)
            win.set_cursor(blank)
            disp.flush()
EOF
}

alive() {
  local p
  for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && return 0; done
  return 1
}

close_all() {
  ((${#pids[@]})) && kill "${pids[@]}" 2>/dev/null
  pids=()
}

# 0 if the last input (idle ms ago) came from a saver key: stamped at most
# 1.5s before it, which also covers the key's release landing a poll later.
saver_key() {
  [[ -e $RUN/key ]] || return 1
  local now stamp
  now=$(date +%s%3N)
  stamp=$(date +%s%3N -r "$RUN/key")
  ((stamp >= now - $1 - 1500))
}

# 0 for the first 1.5s after launch: input then (a shortcut's keys let go
# a moment late, a nudge of the mouse) would close the windows before the
# title has even started, which looks like a crash.
settling() {
  (($(date +%s%3N) - launched < 1500))
}

# Saver windows from any instance (the idle service, or `now`/`test`), so
# the two never stack a second set of windows on top of the first.
running() {
  pgrep -u "$UID" -f -- '--class cmatrix-saver' >/dev/null
}

watchers=()
trap 'close_all; ((${#watchers[@]})) && kill "${watchers[@]}" 2>/dev/null; exit' INT TERM

MODE=${1:-}
case $MODE in
'')
  # notice sources' collectors; ones without a `watch` just exit
  while read -r src; do
    "$src" watch &
    watchers+=($!)
  done < <("$SCENE" sources)
  ;;
now | blank)
  running && exit 0
  [[ $MODE == blank ]] && export CMATRIX_SAVER_BLANK=1
  shift
  [[ -n $* ]] && export CMATRIX_SAVER_AWAY="$*"
  sleep 0.5 # let the shortcut's keys come up before the windows open
  launch
  ;;
test)
  for i in 5 4 3 2 1; do
    printf '\rcmatrix-saver in %d… ' "$i"
    sleep 1
  done
  printf '\r\e[K'
  launch
  ;;
esac

# While the windows are up it polls every 0.2s, so input closes them at
# once rather than up to $POLL later.
# dismissed: the windows went away without any input (quit with q, or
# kitty failed to start). Don't relaunch until the user actually comes
# back — otherwise a broken launch retries every poll for as long as
# they're away.
prev=0
dismissed=0
while sleep "$( ((${#pids[@]})) && echo 0.2 || echo "$POLL")"; do
  idle=$(idle_ms) || continue
  [[ -z $idle ]] && continue
  ((idle < prev)) && dismissed=0 # idle timer reset: input

  if ((${#pids[@]})); then
    if ! alive; then
      pids=()
      dismissed=1
      echo "saver windows closed without input; waiting for activity" >&2
    elif [[ -e $RUN/quit ]]; then
      close_all
    elif ((idle < prev)) && ! settling && ! saver_key "$idle"; then
      # a saver key's handler can be a moment behind the input it caused
      sleep 0.15
      idle=$(idle_ms)
      saver_key "${idle:-0}" || close_all
    fi
    ((${#pids[@]} == 0)) && [[ -n $MODE ]] && exit 0
  elif ((!dismissed && idle >= IDLE_SECS * 1000)) && ! idle_inhibited && ! locked && ! running; then
    launch
  fi
  prev=$idle
done
