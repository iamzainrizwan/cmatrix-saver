#!/usr/bin/env python3
# cmatrix-saver scene: Tetris that plays itself. For each piece the bot
# tries every rotation and column and picks the landing that leaves the
# board flattest and with fewest holes; then it has to get there like a
# player would, one rotation or step a tick while gravity pulls the piece
# down. Gravity speeds up every 10 lines, so sooner or later the piece lands
# before the bot can steer it home, the stack climbs and it tops out. Then
# it dissolves and a new game starts. Score: points (40/100/300/1200 per 1-4
# lines, times the level), lines, level, and the best kept across runs.
import os, random, sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _scene import Scene, main, HI, MID, LOW, DIM, FAINT, ACCENT  # noqa: E402

BW, BH, HIDDEN = 10, 20, 2  # board, plus rows above it pieces spawn into

SHAPES = {  # each rotation as cells in a 4x4 box
    "I": ["....XXXX........", "..X...X...X...X.", "........XXXX....", ".X...X...X...X.."],
    "O": [".XX..XX........."] * 4,
    "T": [".X..XXX.........", ".X...XX..X......", "....XXX..X......", ".X..XX...X......"],
    "S": [".XX.XX..........", ".X...XX...X.....", ".....XX.XX......", "X...XX...X......"],
    "Z": ["XX...XX.........", "..X..XX..X......", "....XX...XX.....", ".X..XX..X......."],
    "J": ["X...XXX.........", ".XX..X...X......", "....XXX...X.....", ".X...X..XX......"],
    "L": ["..X.XXX.........", ".X...X...XX.....", "....XXX.X.......", "XX...X...X......"],
}
ROTS = {k: [[(i % 4, i // 4) for i, c in enumerate(r) if c == "X"] for r in v]
        for k, v in SHAPES.items()}
TONE = {"I": HI, "O": MID, "T": ACCENT, "S": LOW, "Z": LOW, "J": MID, "L": HI}
# rows of gravity per tick, by level
GRAVITY = [0.04, 0.06, 0.08, 0.11, 0.15, 0.2, 0.28, 0.4, 0.6, 0.9, 1.4, 2.2, 3.5, 6, 22]
POINTS = [0, 40, 100, 300, 1200]


class Tetris(Scene):
    DELAYS = [0.25, 0.18, 0.13, 0.1, 0.085, 0.07, 0.05, 0.035, 0.02]
    MAX_GAME = 900  # it always tops out in the end
    HOLD = 1.5

    def new_game(self):
        self.board = [[None] * BW for _ in range(BH + HIDDEN)]
        self.bag = []
        self.next = self.draw_bag()
        self.score = self.lines = 0
        self.level = 1
        self.clearing = None
        self.fall = 0.0
        self.best_score = self.best.get("tetris")
        self.layout()
        self.spawn()
        self.render()

    def layout(self):
        # cells as big as fit: 2s columns by s rows
        self.s = max(1, min((self.h - 3) // BH, (self.w - 24) // (BW * 2)))
        bw, bh = BW * 2 * self.s, BH * self.s
        self.ox = (self.w - bw) // 2
        self.oy = max(1, (self.h - bh) // 2)

    def draw_bag(self):
        if not self.bag:
            self.bag = list(ROTS)
            random.shuffle(self.bag)
        return self.bag.pop()

    def fits(self, kind, rot, x, y):
        for cx, cy in ROTS[kind][rot]:
            bx, by = x + cx, y + cy
            if not (0 <= bx < BW and by < BH + HIDDEN) or by >= 0 and self.board[by][bx]:
                return False
        return True

    def spawn(self):
        self.kind, self.next = self.next, self.draw_bag()
        self.rot, self.x, self.y = 0, 3, 0
        self.fall = 0.0
        if not self.fits(self.kind, self.rot, self.x, self.y):
            return False
        self.target = self.plan()
        return True

    # -- the bot ----------------------------------------------------------

    def plan(self):
        best, best_key = (0, 3), None
        for rot in range(4):
            for x in range(-2, BW):
                if not self.fits(self.kind, rot, x, 0):
                    continue
                y = 0
                while self.fits(self.kind, rot, x, y + 1):
                    y += 1
                key = self.rate(self.kind, rot, x, y)
                if best_key is None or key > best_key:
                    best, best_key = (rot, x), key
        return best

    def rate(self, kind, rot, x, y):
        board = [row[:] for row in self.board]
        for cx, cy in ROTS[kind][rot]:
            board[y + cy][x + cx] = kind
        full = [r for r in range(len(board)) if all(board[r])]
        board = [row for r, row in enumerate(board) if r not in full]
        heights, holes = [], 0
        for c in range(BW):
            top = next((r for r in range(len(board)) if board[r][c]), len(board))
            heights.append(len(board) - top)
            holes += sum(1 for r in range(top, len(board)) if not board[r][c])
        bump = sum(abs(a - b) for a, b in zip(heights, heights[1:]))
        return (-0.51 * sum(heights) + 0.76 * len(full) - 0.7 * holes
                - 0.18 * bump - 0.1 * max(heights))

    # -- the game ---------------------------------------------------------

    def step(self):
        if self.clearing:
            rows, ticks = self.clearing
            if ticks:
                self.clearing = (rows, ticks - 1)
            else:
                self.board = [r for i, r in enumerate(self.board) if i not in rows]
                self.board[:0] = [[None] * BW for _ in rows]
                self.clearing = None
                if not self.spawn():
                    return self.top_out()
            self.render()
            return True
        rot, x = self.target
        if self.rot != rot and self.fits(self.kind, (self.rot + 1) % 4, self.x, self.y):
            self.rot = (self.rot + 1) % 4
        elif self.x != x and self.fits(self.kind, self.rot, self.x + (1 if x > self.x else -1), self.y):
            self.x += 1 if x > self.x else -1
        elif self.rot == rot and self.x == x:
            self.fall += 1.0  # lined up: soft drop
        self.fall += GRAVITY[min(self.level - 1, len(GRAVITY) - 1)]
        while self.fall >= 1:
            self.fall -= 1
            if self.fits(self.kind, self.rot, self.x, self.y + 1):
                self.y += 1
            else:
                if not self.lock():
                    return self.top_out()
                break
        self.render()
        return True

    def lock(self):
        for cx, cy in ROTS[self.kind][self.rot]:
            self.board[self.y + cy][self.x + cx] = self.kind
        if any(any(row) for row in self.board[:HIDDEN]):
            return False
        full = [r for r in range(len(self.board)) if all(self.board[r])]
        if full:
            self.lines += len(full)
            self.score += POINTS[len(full)] * self.level
            self.level = self.lines // 10 + 1
            self.clearing = (set(full), 3)
            self.kind = None
            return True
        return self.spawn()

    def top_out(self):
        self.best_score = self.best.offer("tetris", self.score)
        self.render()
        return False

    # -- drawing ----------------------------------------------------------

    def block(self, bx, by, ch, tone):
        s = self.s
        for dy in range(s):
            for dx in range(2 * s):
                self.put(self.ox + bx * 2 * s + dx, self.oy + (by - HIDDEN) * s + dy, ch, tone)

    def render(self):
        self.clear()
        s, bw, bh = self.s, BW * 2 * self.s, BH * self.s
        for y in range(bh):
            self.put(self.ox - 1, self.oy + y, "▐", DIM)
            self.put(self.ox + bw, self.oy + y, "▌", DIM)
        self.text(self.ox - 1, self.oy + bh, "▝" + "▀" * bw + "▘", DIM)
        rows = self.clearing[0] if self.clearing else ()
        for by in range(HIDDEN, BH + HIDDEN):
            for bx in range(BW):
                kind = self.board[by][bx]
                if by in rows:
                    self.block(bx, by, "█", ACCENT if self.clearing[1] % 2 else HI)
                elif kind:
                    self.block(bx, by, "█", TONE[kind])
        if self.kind:
            gy = self.y
            while self.fits(self.kind, self.rot, self.x, gy + 1):
                gy += 1
            for cx, cy in ROTS[self.kind][self.rot]:
                if gy + cy >= HIDDEN:
                    self.block(self.x + cx, gy + cy, "░", FAINT)
            for cx, cy in ROTS[self.kind][self.rot]:
                if self.y + cy >= HIDDEN:
                    self.block(self.x + cx, self.y + cy, "█", TONE[self.kind])
        # the next piece, beside the board
        nx = self.ox + bw + 3
        if nx + 8 * s < self.w:
            self.text(nx, self.oy, "next", DIM)
            for cx, cy in ROTS[self.next][0]:
                for dy in range(s):
                    for dx in range(2 * s):
                        self.put(nx + cx * 2 * s + dx, self.oy + 2 + cy * s + dy, "█", TONE[self.next])
        self.hud = "score %d · lines %d · level %d · best %d" % (
            self.score, self.lines, self.level, max(self.score, self.best_score))

    def on_resize(self):
        self.layout()
        self.render()


if __name__ == "__main__":
    main(Tetris)
