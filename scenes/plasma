#!/usr/bin/env python3
# cmatrix-saver scene: slow colour fields in the scheme's shades, two
# pixels to a character (half blocks), one of two kinds a time:
#   plasma  the demoscene classic, sine waves summed across the screen
#   lava    a lava lamp: blobs warm, rise, cool, sink and merge as they pass
# Every couple of minutes it dissolves and comes back as the other kind (or
# the same one, differently). Nothing to score.
import math, os, random, sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _scene import Scene, main  # noqa: E402

LEVELS = 12


class Plasma(Scene):
    DELAYS = [0.4, 0.3, 0.22, 0.17, 0.13, 0.1, 0.075, 0.055, 0.04]
    MAX_GAME = 150
    HOLD = 0

    def new_game(self):
        self.kind = random.choice(["plasma", "lava"])
        self.t = random.uniform(0, 100)
        self.pw, self.ph = self.w, self.h * 2
        self.shades()
        getattr(self, "setup_" + self.kind)()

    def shades(self):
        lo = 0.12 if self.kind == "plasma" else 0.0
        self.shade = [self.ramp(lo + (1 - lo) * i / (LEVELS - 1)) for i in range(LEVELS)]

    def on_colour(self):
        self.shades()

    def on_resize(self):
        self.pw, self.ph = self.w, self.h * 2
        getattr(self, "setup_" + self.kind)()

    # -- plasma -----------------------------------------------------------

    def setup_plasma(self):
        r = random.uniform
        self.f = [r(0.03, 0.09), r(0.05, 0.14), r(0.02, 0.06), r(0.08, 0.2)]
        self.v = [r(0.3, 0.8), r(0.2, 0.7), r(0.1, 0.5), r(0.4, 1.0)]
        # distance from a point off to one side, worked out once
        cx, cy = r(-0.3, 1.3) * self.pw, r(-0.3, 1.3) * self.ph
        self.dist = [[math.hypot(x - cx, y - cy) for x in range(self.pw)] for y in range(self.ph)]

    def frame_plasma(self):
        f, v, t = self.f, self.v, self.t
        sin = math.sin
        cols = [sin(x * f[0] + t * v[0]) for x in range(self.pw)]
        diag = [sin(s * f[2] + t * v[2]) for s in range(self.pw + self.ph)]
        k = (LEVELS - 1) / 8.0
        rows = []
        for y in range(self.ph):
            ry = sin(y * f[1] + t * v[1]) + 4
            d = self.dist[y]
            phase = t * v[3]
            rows.append([int((cols[x] + ry + diag[x + y] + sin(d[x] * f[3] - phase)) * k)
                         for x in range(self.pw)])
        return rows

    # -- lava -------------------------------------------------------------

    def setup_lava(self):
        n = max(4, min(10, self.pw * self.ph // 2500))
        self.blobs = []
        for i in range(n):
            self.blobs.append({
                "x": random.uniform(0.15, 0.85),
                "r": random.uniform(0.05, 0.1) * min(self.pw, self.ph * 1.6),
                "period": random.uniform(40, 90),  # about that many seconds up and down
                "phase": random.uniform(0, 2 * math.pi),
                "sway": random.uniform(0.02, 0.08),
            })

    def frame_lava(self):
        pw, ph, t = self.pw, self.ph, self.t
        field = [[0.0] * pw for _ in range(ph)]
        for b in self.blobs:
            # up and down the lamp, slowly, with a little sideways drift
            yy = (0.5 - 0.42 * math.cos(t * 2 * math.pi / b["period"] + b["phase"])) * ph
            xx = (b["x"] + b["sway"] * math.sin(t / 7 + b["phase"])) * pw
            # bigger near the top, where it's warmest
            r = b["r"] * (1.15 - 0.3 * yy / ph)
            r2, reach = r * r, int(r * 2.6)
            for y in range(max(0, int(yy) - reach), min(ph, int(yy) + reach)):
                dy2 = (y - yy) ** 2
                row = field[y]
                for x in range(max(0, int(xx) - reach), min(pw, int(xx) + reach)):
                    row[x] += r2 / ((x - xx) ** 2 + dy2 + 1)
        top = LEVELS - 1
        # under 0.35 is black; the glow builds to the blob's edge at 1, the
        # inside brightest toward the middle
        return [[0 if v < 0.35 else min(top, int(2 + (v - 0.35) * 9)) for v in row]
                for row in field]

    # -- drawing ----------------------------------------------------------

    def step(self):
        self.t += 0.12 if self.kind == "plasma" else 0.1
        lv = getattr(self, "frame_" + self.kind)()
        shade, black = self.shade, self.kind == "lava"
        for ty in range(self.h):
            top, bot = lv[ty * 2], lv[ty * 2 + 1]
            row = self.cells[ty]
            for x in range(self.w):
                a, b = top[x], bot[x]
                if black and not a and not b:
                    row[x] = (" ", None, None)
                else:
                    row[x] = ("▀", shade[a], shade[b])
        return True


if __name__ == "__main__":
    main(Plasma)
