#!/usr/bin/env python3
# cmatrix-saver scene: a flock (boids: keep apart, match heading, stay
# together), each bird an arrow pointing where it's going with a short
# fading trail, and a hunter (◆) after them. The flock scatters when it
# comes close; when it catches one it stops a moment to eat, and it gets
# hungrier, and so faster, as the game goes on, until it has caught the
# last one and a new flock flies in. Score: caught out of the flock.
import math, os, random, sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _scene import Scene, main, HI, MID, DIM, FAINT, ACCENT  # noqa: E402

ARROWS = "→↘↓↙←↖↑↗"  # by heading, clockwise from east (y grows down)
SEE, NEAR, FEAR = 12.0, 3.5, 16.0  # how far a bird sees, crowds, fears
TOP, LEAST = 1.1, 0.5  # a bird's speed limits, per tick


class Bird:
    __slots__ = ("x", "y", "vx", "vy", "trail")

    def __init__(self, x, y):
        a = random.uniform(0, 2 * math.pi)
        self.x, self.y = x, y
        self.vx, self.vy = math.cos(a) * 0.8, math.sin(a) * 0.8
        self.trail = []


class Boids(Scene):
    DELAYS = [0.15, 0.11, 0.085, 0.065, 0.055, 0.045, 0.035, 0.025, 0.016]
    MAX_GAME = 360
    HOLD = 1.5

    def new_game(self):
        # world units: a column across, half a row down, so space is square
        self.ww, self.wh = float(self.w), float((self.h - 1) * 2)
        n = max(25, min(90, self.w * self.h // 110))
        cx, cy = random.uniform(0.2, 0.8) * self.ww, random.uniform(0.2, 0.8) * self.wh
        self.birds = [Bird(cx + random.uniform(-15, 15), cy + random.uniform(-8, 8))
                      for _ in range(n)]
        self.flock = n
        self.hunter = Bird(random.choice([2.0, self.ww - 2]), random.uniform(2, self.wh - 2))
        self.hunger = 0.0  # added to the hunter's speed, growing
        self.eating = 0
        self.draw()

    def caught(self):
        return self.flock - len(self.birds)

    def steer_in(self, b, margin=8.0, push=0.08):
        if b.x < margin:
            b.vx += push
        elif b.x > self.ww - margin:
            b.vx -= push
        if b.y < margin:
            b.vy += push
        elif b.y > self.wh - margin:
            b.vy -= push

    def limit(self, b, top, least):
        s = math.hypot(b.vx, b.vy) or 1e-6
        if s > top:
            b.vx, b.vy = b.vx / s * top, b.vy / s * top
        elif s < least:
            b.vx, b.vy = b.vx / s * least, b.vy / s * least

    def move(self, b):
        b.trail.insert(0, (b.x, b.y))
        del b.trail[3:]
        b.x = min(max(b.x + b.vx, 0.0), self.ww - 0.01)
        b.y = min(max(b.y + b.vy, 0.0), self.wh - 0.01)

    def step(self):
        h = self.hunter
        # who's near whom: birds bucketed by SEE-sized squares
        grid = {}
        for b in self.birds:
            grid.setdefault((int(b.x // SEE), int(b.y // SEE)), []).append(b)
        for b in self.birds:
            gx, gy = int(b.x // SEE), int(b.y // SEE)
            n = cx = cy = ax = ay = sx = sy = 0.0
            for i in (-1, 0, 1):
                for j in (-1, 0, 1):
                    for o in grid.get((gx + i, gy + j), ()):
                        if o is b:
                            continue
                        dx, dy = o.x - b.x, o.y - b.y
                        d2 = dx * dx + dy * dy
                        if d2 > SEE * SEE:
                            continue
                        n += 1
                        cx += o.x
                        cy += o.y
                        ax += o.vx
                        ay += o.vy
                        if d2 < NEAR * NEAR:
                            sx -= dx / (d2 + 0.1)
                            sy -= dy / (d2 + 0.1)
            if n:
                b.vx += (cx / n - b.x) * 0.004 + (ax / n - b.vx) * 0.05 + sx * 0.6
                b.vy += (cy / n - b.y) * 0.004 + (ay / n - b.vy) * 0.05 + sy * 0.6
            dx, dy = b.x - h.x, b.y - h.y
            d = math.hypot(dx, dy)
            if d < FEAR:
                b.vx += dx / (d + 0.1) * 0.12
                b.vy += dy / (d + 0.1) * 0.12
            b.vx += random.uniform(-0.03, 0.03)
            b.vy += random.uniform(-0.03, 0.03)
            self.steer_in(b)
            self.limit(b, TOP, LEAST)
        for b in self.birds:
            self.move(b)
        self.hunt()
        self.draw()
        return bool(self.birds)

    def hunt(self):
        h = self.hunter
        if self.eating:
            self.eating -= 1
            h.vx *= 0.8
            h.vy *= 0.8
            self.move(h)
            return
        self.hunger += 0.0007
        prey = min(self.birds, key=lambda b: (b.x - h.x) ** 2 + (b.y - h.y) ** 2, default=None)
        if prey is None:
            return
        dx, dy = prey.x - h.x, prey.y - h.y
        d = math.hypot(dx, dy) or 1e-6
        # turns toward the prey rather than piling on speed, so it doesn't
        # overshoot once it's quick
        speed = min(0.85 + self.hunger, 1.8)
        h.vx += (dx / d * speed - h.vx) * 0.2
        h.vy += (dy / d * speed - h.vy) * 0.2
        x0, y0 = h.x, h.y
        self.move(h)
        # caught anywhere along this tick's move, not just where it ended
        sx, sy = h.x - x0, h.y - y0
        t = ((prey.x - x0) * sx + (prey.y - y0) * sy) / (sx * sx + sy * sy or 1e-6)
        t = min(max(t, 0.0), 1.0)
        if math.hypot(prey.x - (x0 + sx * t), prey.y - (y0 + sy * t)) < 1.6:
            self.birds.remove(prey)
            self.eating = 18

    def cell(self, x, y):
        return int(x), int(y // 2) + 1  # the top row is the score's

    def draw(self):
        for y in range(1, self.h):
            self.cells[y][:] = [(" ", None, None)] * self.w
        for b in self.birds:
            for i, (tx, ty) in enumerate(b.trail[1:]):
                self.put(*self.cell(tx, ty), "·", DIM if i == 0 else FAINT)
        h = self.hunter
        for b in self.birds:
            a = int(round(math.atan2(b.vy, b.vx) / (math.pi / 4))) % 8
            near = (b.x - h.x) ** 2 + (b.y - h.y) ** 2 < FEAR * FEAR
            self.put(*self.cell(b.x, b.y), ARROWS[a], HI if near else MID)
        for i, (tx, ty) in enumerate(h.trail[1:]):
            self.put(*self.cell(tx, ty), "·", DIM)
        self.put(*self.cell(h.x, h.y), "◆", ACCENT)
        self.hud = "caught %d of %d" % (self.caught(), self.flock)

    def on_resize(self):
        self.ww, self.wh = float(self.w), float((self.h - 1) * 2)
        for b in self.birds + [self.hunter]:
            b.x, b.y = min(b.x, self.ww - 0.01), min(b.y, self.wh - 0.01)
            b.trail = []
        self.draw()


if __name__ == "__main__":
    main(Boids)
