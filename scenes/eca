#!/usr/bin/env python3
# cmatrix-saver scene: elementary cellular automata, Game of Life's
# one-dimensional cousin. A row of cells, each next row worked out from the
# three cells above it by one of 256 rules, written down the screen two rows
# to a character (half blocks) and then scrolling up. Rule 30's chaos (it
# was Mathematica's random number generator), 110's gliders (it can run any
# program), 90's Sierpinski triangles, and others; from a single cell or a
# random row. A rule runs a minute and a half, then dissolves into the
# next. Cells are shaded by the pattern above them, which brings out the
# texture. Score: the rule and the generation.
import os, random, sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _scene import Scene, main, HI, MID, LOW  # noqa: E402

RULES = {  # rule: how it starts (one cell in the middle, at the right, or random)
    30: "one", 45: "one", 73: "random", 90: "one", 105: "one", 110: "right",
    150: "one", 54: "random", 18: "one", 22: "one", 126: "random", 60: "one",
    57: "one", 62: "random", 137: "random", 169: "random", 193: "random",
    225: "one", 182: "one", 124: "left", 41: "random", 106: "random",
}
# the shade a live cell gets from the three cells it came from
SHADE = [HI, HI, MID, MID, HI, MID, LOW, LOW]


class Eca(Scene):
    DELAYS = [0.3, 0.22, 0.16, 0.12, 0.1, 0.075, 0.055, 0.04, 0.025]
    MAX_GAME = 90
    HOLD = 1.0

    def __init__(self):
        self.queue = []
        super().__init__()

    def new_game(self):
        if not self.queue:
            self.queue = list(RULES)
            random.shuffle(self.queue)
        self.rule = self.queue.pop()
        how = RULES[self.rule]
        n = self.w
        if how == "random":
            self.row = [random.random() < 0.5 for _ in range(n)]
        else:
            self.row = [False] * n
            self.row[{"one": n // 2, "right": n - 2, "left": 1}[how]] = True
        self.marks = [HI if c else None for c in self.row]
        self.gen = 0
        self.y = 1  # the character row being written; the top is the score's
        self.half = 0
        self.write()

    def next_row(self):
        row, n, rule = self.row, len(self.row), self.rule
        new, marks = [], []
        for i in range(n):
            p = row[i - 1] << 2 | row[i] << 1 | row[(i + 1) % n]
            alive = bool(rule >> p & 1)
            new.append(alive)
            marks.append(SHADE[p] if alive else None)
        self.row, self.marks = new, marks
        self.gen += 1

    def write(self):
        top = self.half == 0
        for x, tone in enumerate(self.marks):
            if top:
                self.put(x, self.y, "▀" if tone is not None else " ", tone)
                continue
            ch, above, _ = self.cells[self.y][x]
            if ch == " ":
                self.put(x, self.y, "▄" if tone is not None else " ", tone)
            elif tone is None:
                pass  # keep the top half as it is
            elif tone == above:
                self.put(x, self.y, "█", tone)
            else:
                self.put(x, self.y, "▀", above, tone)
        self.hud = "rule %d · gen %d" % (self.rule, self.gen)

    def step(self):
        self.next_row()
        self.half ^= 1
        if self.half == 0:
            if self.y == self.h - 1:
                self.scroll_up()
            else:
                self.y += 1
        self.write()
        return True

    def on_resize(self):
        # the old rows are gone with the clear; carry on from the top
        if len(self.row) != self.w:
            self.new_game()
            return
        self.y, self.half = 1, 0
        self.write()


if __name__ == "__main__":
    main(Eca)
